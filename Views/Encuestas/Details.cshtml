@model ScaffoldingV1.Models.Encuesta

@{
    ViewData["Title"] = "Detalles Encuesta";
}

<h1>Detalles Encuesta</h1>

<div>
    <h4>Encuesta</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Título</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Titulo)</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class="col-sm-2">Fecha creación</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FechaCreacion)</dd>

        <dt class="col-sm-2">Activa</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Activa)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Volver</a>
</div>