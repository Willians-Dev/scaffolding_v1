@model ScaffoldingV1.Models.Pregunta

@{
    ViewData["Title"] = "Detalles Pregunta";
}

<h1>Detalles Pregunta</h1>

<div>
    <h4>Pregunta</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">EncuestaId</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EncuestaId)</dd>

        <dt class="col-sm-2">Texto</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Texto)</dd>

        <dt class="col-sm-2">Tipo</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Tipo)</dd>

        <dt class="col-sm-2">Orden</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Orden)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Volver</a>
</div>