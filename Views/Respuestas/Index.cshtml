@model IEnumerable<ScaffoldingV1.Models.Respuesta>

@{
    ViewData["Title"] = "Respuestas";
}

<h1>Respuestas</h1>

<p>
    <a asp-action="Create">Crear nueva respuesta</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>EncuestaId</th>
            <th>Fecha</th>
            <th>Nombre respondente</th>
            <th>Observación</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.EncuestaId)</td>
                <td>@Html.DisplayFor(modelItem => item.Fecha)</td>
                <td>@Html.DisplayFor(modelItem => item.NombreRespondente)</td>
                <td>@Html.DisplayFor(modelItem => item.Observacion)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>