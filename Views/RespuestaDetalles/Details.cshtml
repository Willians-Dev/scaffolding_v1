@model ScaffoldingV1.Models.RespuestaDetalle

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles</h1>

<div>
    <h4>Detalle de Respuesta</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">RespuestaId</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RespuestaId)</dd>

        <dt class="col-sm-2">PreguntaId</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PreguntaId)</dd>

        <dt class="col-sm-2">OpcionRespuestaId</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.OpcionRespuestaId)</dd>

        <dt class="col-sm-2">Texto respuesta</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TextoRespuesta)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Volver</a>
</div>