@model IEnumerable<ScaffoldingV1.Models.OpcionRespuesta>

@{
    ViewData["Title"] = "Opciones de Respuesta";
}

<h1>Opciones de Respuesta</h1>

<p>
    <a asp-action="Create">Crear nueva opción</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>PreguntaId</th>
            <th>Texto</th>
            <th>Valor</th>
            <th>Orden</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.PreguntaId)</td>
                <td>@Html.DisplayFor(modelItem => item.Texto)</td>
                <td>@Html.DisplayFor(modelItem => item.Valor)</td>
                <td>@Html.DisplayFor(modelItem => item.Orden)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>