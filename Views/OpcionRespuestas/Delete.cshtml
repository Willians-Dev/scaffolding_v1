@model ScaffoldingV1.Models.OpcionRespuesta

@{
    ViewData["Title"] = "Eliminar Opción";
}

<h1>Eliminar Opción</h1>

<h3>¿Está seguro de eliminar este registro?</h3>

<div>
    <h4>Opción de Respuesta</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">PreguntaId</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PreguntaId)</dd>

        <dt class="col-sm-2">Texto</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Texto)</dd>

        <dt class="col-sm-2">Valor</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Valor)</dd>

        <dt class="col-sm-2">Orden</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Orden)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver</a>
    </form>
</div>